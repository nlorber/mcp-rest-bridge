{
  "name": "mcp-rest-bridge",
  "version": "1.3.0",
  "description": "Production-ready MCP server template for wrapping any REST API",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "rm -rf build",
    "build": "tsc",
    "start": "node --env-file=.env build/src/index.js",
    "start:mock": "node --env-file=.env build/mock-api/server.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "dev:mock": "tsx --env-file=.env mock-api/server.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:adversarial": "tsx --env-file=.env tests/adversarial/runner.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "smoke:build": "node scripts/smoke-build.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke:build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11"
  }
}
