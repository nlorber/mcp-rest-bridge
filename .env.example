# Transport: "stdio" (default) or "http"
MCP_TRANSPORT=stdio

# HTTP transport settings
MCP_HTTP_PORT=3456

# HTTP transport hardening (see docs/TRANSPORT.md). Unset values use the transport defaults.
# Express "trust proxy": true, false, a hop count, or an address list such as loopback
# MCP_TRUST_PROXY=loopback
# Refuse to start while MCP_TRUST_PROXY is unset
# MCP_REQUIRE_TRUST_PROXY=false
# MCP_MAX_SESSIONS=1000
# MCP_SESSION_IDLE_TIMEOUT_MS=1800000
# DNS rebinding protection: comma-separated Host hostnames (default: localhost,127.0.0.1,[::1])
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Origins accepted from browser clients (default: none)
# MCP_ALLOWED_ORIGINS=https://app.example.com

# Target API
API_BASE_URL=http://localhost:3100
# Required, no defaults. These are the mock API's demo credentials; replace them for a real API.
API_USERNAME=admin
API_PASSWORD=admin123

# Logging
LOG_LEVEL=info

# Timeouts (ms)
HTTP_TIMEOUT_MS=30000
DEFAULT_TOOL_TIMEOUT_MS=60000

# Cache
CACHE_TTL_MS=300000

# Rate limiting (HTTP transport only)
RATE_LIMIT_MAX_TOKENS=60
RATE_LIMIT_REFILL_RATE=2

# Adversarial tests (optional — required for npm run test:adversarial)
ANTHROPIC_API_KEY=
RUNNER_MODEL=
